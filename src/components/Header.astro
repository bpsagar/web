---
import { Image } from "astro:assets";
import profileImage from "../assets/profile.png";

interface Props {
	title?: string;
	showAvatar?: boolean;
}

const { title, showAvatar = false } = Astro.props;
// The standalone header (no section title) carries the full name.
const brand = title ? "I'm Sagar" : "I'm Sagar Chakravarthy";
---

<div
	class="flex items-center font-host text-sm font-semibold py-4 uppercase tracking-widest"
>
	{
		showAvatar && (
			<div class="header-avatar opacity-0 -translate-x-4 w-0 overflow-hidden transition-all duration-500 ease-in-out">
				<div class="w-5 h-5 rounded-full overflow-hidden border border-zinc-200">
					<Image
						src={profileImage}
						alt="Sagar Chakravarthy"
						width={20}
						height={20}
						class="w-full h-full object-cover"
					/>
				</div>
			</div>
		)
	}
	<span class="text-zinc-400 whitespace-pre" data-brand-typing>{brand}</span>
	{
		title && (
			<>
				<span class="text-zinc-900 mx-2">/</span>
				<span class="text-zinc-900 font-semibold">{title}</span>
			</>
		)
	}
</div>

<script>
	// Replays "visited sagar.im" as a text-editor edit: select "im", cut,
	// jump to start, paste, add the apostrophe, drop the dot => "I'm Sagar",
	// then type out the last name while the hero photo peeps in from below.
	const el = document.querySelector<HTMLElement>("[data-brand-typing]");
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (el && !reduce) {
		const final = el.textContent ?? "";
		let text = "sagar.im";
		let cur = text.length;
		let sel: [number, number] | null = null;
		let showCursor = true;

		const esc = (s: string) =>
			s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
		const cursorStyle = "background:rgba(63,63,70,0.4);color:#18181b;";
		const selStyle = "background:rgba(113,113,122,0.25);color:#18181b;";

		const render = () => {
			let html = "";
			for (let i = 0; i < text.length; i++) {
				const ch = esc(text[i]);
				const inSel = sel && i >= sel[0] && i < sel[1];
				if (showCursor && i === cur) {
					html += `<span style="${cursorStyle}">${ch}</span>`;
				} else if (inSel) {
					html += `<span style="${selStyle}">${ch}</span>`;
				} else {
					html += ch;
				}
			}
			// block cursor past the last character, overlaid so layout doesn't shift
			if (showCursor && cur >= text.length) {
				html +=
					`<span style="position:relative;display:inline-block;width:0">` +
					`<span style="position:absolute;left:0;top:0;bottom:0;width:0.6em;${cursorStyle}"></span></span>`;
			}
			el.innerHTML = html;
		};

		const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
		const step = async (ms: number, fn: () => void) => {
			await sleep(ms);
			fn();
			render();
		};

		(async () => {
			render();
			await sleep(600);
			let clip = "";
			await step(0, () => (sel = [6, 8])); // select "im"
			await step(700, () => {
				// cut
				clip = text.slice(6, 8);
				text = text.slice(0, 6);
				cur = 6;
				sel = null;
			});
			await step(500, () => (cur = 0)); // jump to start
			await step(450, () => {
				// paste
				text = clip + text;
				cur = clip.length;
			});
			await step(350, () => (cur -= 1)); // between i and m
			await step(180, () => {
				// type apostrophe
				text = text.slice(0, cur) + "'" + text.slice(cur);
				cur += 1;
			});
			await step(220, () => (cur += 1)); // after m
			await step(180, () => {
				// type space
				text = text.slice(0, cur) + " " + text.slice(cur);
				cur += 1;
			});
			// walk the cursor to the end so the move is visible
			await sleep(300);
			while (cur < text.length) await step(110, () => (cur += 1));
			await step(350, () => {
				// backspace the dot
				text = text.slice(0, -1);
				cur = text.length;
			});
			// type the rest of the name (if any) as the hero photo peeps in
			const rest = final.slice(text.length);
			document.getElementById("hero-profile-pic")?.classList.add("peeped");
			for (const ch of rest) {
				await step(75, () => {
					text += ch;
					cur = text.length;
				});
			}
			// blink twice, then hide the cursor
			for (let i = 0; i < 2; i++) {
				await step(350, () => (showCursor = false));
				await step(350, () => (showCursor = true));
			}
			await step(500, () => (showCursor = false));
			el.textContent = final;
		})();
	}
</script>
